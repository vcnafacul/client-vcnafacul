# Este arquivo vira o `.env` (não versionado): chaves e flags locais.
#
# Os endereços NÃO ficam aqui: vêm do `.env.<modo>` versionado, escolhido pelo
# Vite conforme o comando (`yarn dev` → .env.development, `build:homologation`
# → .env.homologation, `build` → .env.production):
#   VITE_BASE_URL        api (local: http://localhost:3333)
#   VITE_APP_BASE_URL    o próprio site
#   VITE_BASE_FTP        arquivos servidos pela api
#   VITE_FTP_PROFILE     fotos de perfil antigas (FTP)
#   VITE_BRASIL_API_URL  BrasilAPI (CEP etc.)
#   VITE_VCNAFACUL_ID    id do cursinho Você na Facul
# Variável de ambiente do processo vence os arquivos: o compose do
# vcnafacul-stack (tickets/055) passa VITE_BASE_URL assim.

# Firebase (chat de suporte e push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Número do meio do APP_ID (1:<sender>:web:…). Ver discussion/pwa-push/MANUAL-01.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Chave pública do Web Push (Firebase → Cloud Messaging → Web Push certificates).
VITE_FIREBASE_VAPID_KEY=

# Google Maps (localiza cursinho) — uma chave por ambiente. Vazio: o mapa não carrega.
VITE_GOOGLE_MAPS_API_KEY=

# Caderno (POC Overleaf) — mostra o botão de rascunho em simulado bloqueado
VITE_CADERNO_DRAFT=false

# PWA/push (discussion pwa-push). Qualquer valor diferente de "true" desliga
# e desregistra o service worker.
VITE_PUSH_ENABLED=false
# Banner "Ativar notificações" no dashboard: off | colaboradores | todos.
# Rollout (discussion pwa-push, QA-01): off → colaboradores → todos.
VITE_PUSH_BANNER=off

# Opcional: versão enviada junto com os erros do front (sendFrontendError).
# VITE_APP_VERSION=
